# Example environment variables for DaruruFarm project
# Copy this file to .env and fill in the actual values.
# For Nest-only vars, prefer backend/.env (see backend/.env.example).

# Database configuration (use RDS endpoint on AWS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_DATABASE=daruru_farm

# JWT secret for authentication
JWT_SECRET=your_jwt_secret

# Application port
PORT=3000

# Frontend API URL (Vite expects VITE_ prefix)
# Local: http://127.0.0.1:3000  |  AWS: https://api.yourdomain.com
VITE_API_URL=http://127.0.0.1:3000

# Google Sign-In (same OAuth 2.0 Web client ID in backend + frontend)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Razorpay Checkout (https://dashboard.razorpay.com/app/keys)
# Use rzp_test_… keys while testing. Amount is ₹5,000 / year.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Pomegranate fruit AI (Nest reads these from backend/.env)
# Leave empty to resolve ../ml/pomegranate from the backend working directory.
POMEGRANATE_ML_ROOT=
POMEGRANATE_PYTHON=python
POMEGRANATE_INFER_URL=http://127.0.0.1:8001
# Warm server bind (set 0.0.0.0 only inside a private VPC/container network)
POMEGRANATE_INFER_HOST=127.0.0.1
POMEGRANATE_INFER_PORT=8001
