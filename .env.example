# Example environment variables for DaruruFarm project
# Copy this file to .env and fill in the actual values.

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_DATABASE=daruru_farm

# JWT secret for authentication
JWT_SECRET=your_jwt_secret

# Application port
PORT=3000

# Frontend API URL (Vite expects VITE_ prefix)
VITE_API_URL=http://localhost:3000

# Razorpay Checkout (https://dashboard.razorpay.com/app/keys)
# Use rzp_test_… keys while testing. Amount is ₹3000 / year.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
