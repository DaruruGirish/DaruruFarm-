# Copy to backend/.env (or set in AWS Parameter Store / Secrets Manager).
# Never commit real secrets.

# Database (local MySQL or AWS RDS endpoint)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=daruru_farm

JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
# Docker/first-boot: set true to auto-create tables. Prefer false once schema is stable.
TYPEORM_SYNCHRONIZE=

# Optional legacy weather-ML stub (not the fruit DenseNet pipeline)
ML_SERVICE_URL=

# Google Sign-In (same Web client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Pomegranate fruit disease AI ---
# Leave POMEGRANATE_ML_ROOT empty to use ../ml/pomegranate relative to backend cwd.
# On AWS set an absolute Linux path, e.g. /opt/darurufarm/ml/pomegranate
POMEGRANATE_ML_ROOT=
# python on Windows; python3 on most Linux AMIs
POMEGRANATE_PYTHON=python
# Warm inference server (same host). Use internal DNS if ML runs as a separate service.
POMEGRANATE_INFER_URL=http://127.0.0.1:8001

# RAG / LLM (optional; not used by current disease-detect-only flow)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chatbot_documents
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
